  "compounds": [
    {
      "name": "All Apps (API HTTPS + RobotApp.winform + Client.Ui)",
      "configurations": [
        "RobotStopApp.Api (HTTPS)",
        "RobotStopApp.RobotApp.WinForms",
        "RobotStopApp.Client.Ui"
      ],
      "stopAll": true
    },
    {
      "name": "All Apps (API + RobotApp.winform + Client.Ui)",
      "configurations": [
        "RobotStopApp.Api (HTTP)",
        "RobotStopApp.RobotApp.WinForms",
        "RobotStopApp.Client.Ui"
