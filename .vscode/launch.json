      "args": [],
      "cwd": "${workspaceFolder}/src/RobotStopApp.RobotApp.WinForms",
      "stopAtEntry": false,
      "console": "internalConsole",
      "preLaunchTask": "build-all",
      "justMyCode": true
    },
    {
      "name": "RobotStopApp.Client.Ui",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/RobotStopApp.Client.Ui/bin/Debug/net9.0/RobotStopApp.Client.Ui.dll",
