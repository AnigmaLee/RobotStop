{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RobotStopApp.Api (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/RobotStopApp.Api/bin/Debug/net9.0/RobotStopApp.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RobotStopApp.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "preLaunchTask": "build-api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5188",
        "ROBOTSTOPAPP_APIKEY": "dev-local-key-change-me"
      },
      "justMyCode": true
    },
    {
      "name": "RobotStopApp.Api (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/RobotStopApp.Api/bin/Debug/net9.0/RobotStopApp.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RobotStopApp.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "preLaunchTask": "build-api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7049;http://localhost:5188",
        "ROBOTSTOPAPP_APIKEY": "dev-local-key-change-me"
      },
      "justMyCode": true
    },
    {
      "name": "RobotStopApp.RobotApp",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/RobotStopApp.RobotApp/bin/Debug/net9.0/RobotStopApp.RobotApp.dll",
